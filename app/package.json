{
  "name": "digi-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop cat that hides in the corner of your screen",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
