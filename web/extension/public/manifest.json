{
  "manifest_version": 3,
  "name": "Digi-Pet",
  "description": "A little study companion that stays with you in Chrome.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
